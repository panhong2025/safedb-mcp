{
  "name": "safedb-mcp",
  "version": "1.1.0",
  "description": "Security-first database MCP server. Safe AI access to your PostgreSQL databases.",
  "keywords": [
    "mcp",
    "database",
    "postgresql",
    "ai",
    "security",
    "sql"
  ],
  "license": "MIT",
  "author": "SafeDB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panhong2025/safedb-mcp.git"
  },
  "homepage": "https://github.com/panhong2025/safedb-mcp#readme",
  "bugs": {
    "url": "https://github.com/panhong2025/safedb-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "safedb-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "node-sql-parser": "^5.3.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
